{
  "name": "spraakbericht",
  "version": "0.2.0",
  "private": true,
  "description": "Sunshower spraakbericht — feedbacklus van monteur naar wachtkamer: audio-input PWA (nl/de) + API (logboek) + lokale transcriptie",
  "scripts": {
    "test": "node tests/consistentie.test.js && node tests/api.test.js",
    "test:loop": "node tests/loop.test.js",
    "test:all": "npm test && npm run test:loop",
    "dev": "node tools/local-api.js",
    "mock:diagnose": "node tools/mock-diagnose.js",
    "whisper": "python3 tools/whisper-server.py",
    "consumer": "node tools/mac-consumer.js --watch"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "redis": "^4.7.1",
    "web-push": "^3.6.7"
  }
}
